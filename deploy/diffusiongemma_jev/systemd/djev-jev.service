[Unit]
Description=OpenJev System One server (DiffusionGemma-26B-A4B unified AsyncLLM engine)
Documentation=https://github.com/razorback16/openjev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HF_HOME=/opt/hf
Environment=OPENJEV_MODEL=RedHatAI/diffusiongemma-26B-A4B-it-NVFP4
Environment=OPENJEV_HOST=127.0.0.1
Environment=OPENJEV_PORT=8011
Environment=OPENJEV_MAX_MODEL_LEN=16384
Environment=OPENJEV_GPU_UTIL=0.90
ExecStart=/opt/venv/vllm/bin/python -m openjev
TimeoutStartSec=900
Restart=always
RestartSec=10
StandardOutput=append:/var/log/djev-jev.log
StandardError=append:/var/log/djev-jev.log

[Install]
WantedBy=multi-user.target
