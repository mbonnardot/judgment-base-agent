# Copy this file to examples/.env and fill in the blanks:
#
#   cp examples/.env.example examples/.env
#
# examples/.env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# 1. Judgment backend (required)
#
# Pick ONE of the options below. Option A is the default managed TypeSafe API.
# Option B connects to OpenJev (https://github.com/razorback16/openjev) via
# free hosted Codiv, local Apple Silicon MLX, Docker, or a GCP L4 GPU.
# ---------------------------------------------------------------------------

# --- Option A: managed TypeSafe System One API (default) -------------------
TYPESAFE_API_KEY=your_typesafe_api_key_here
JUDGMENT_MODEL=judgment-latest

# --- Option B: OpenJev (DiffusionGemma-26B-A4B) ----------------------------
# Uncomment OPENJEV_BASE_URL (or DIFFUSIONGEMMA_JEV_URL) to route every
# JudgmentAgent, JudgmentSwitch, JudgmentGuard, JudgmentMap, and
# JudgmentRubricEvaluator call to OpenJev (`POST /v1/systemone`) with zero
# agent code changes.
#
# 1) Free hosted OpenJev on Codiv (100M free input tokens):
# OPENJEV_BASE_URL=https://api.codiv.ai
# OPENJEV_API_KEY=sk-codiv-...
#
# 2) Local Apple Silicon MLX (`OPENJEV_BACKEND=mlx python -m openjev`) or
#    Docker (`docker run --gpus all -p 8080:8080 razorback16/openjev:0.3.0`):
# OPENJEV_BASE_URL=http://127.0.0.1:8080
#
# 3) Shared GCP L4 GPU VM via IAP tunnel (`./scripts/connect_gpu.sh`):
# OPENJEV_BASE_URL=http://127.0.0.1:8011

# ---------------------------------------------------------------------------
# 2. Gemini model used by the LLM half of the example agents (required)
#
# Authenticate locally with: gcloud auth application-default login
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash
